# Production environment (Cloud Run). Set these as Cloud Run service env vars
# / secrets — do NOT commit real values. See DEPLOY.md for how to obtain each.

# --- Postgres (Neon; serverless, scales to zero) ---
# Use a CLEAN URL with no ssl query args — DB_REQUIRE_SSL handles TLS for both
# the async (asyncpg) and Alembic (psycopg2) drivers.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME
DB_REQUIRE_SSL=true

# --- Job dispatch ---
# "cloudtasks" pushes jobs to the worker over HTTP, which is what lets the
# worker scale to zero. "arq" is the local-dev pull transport and needs Redis.
JOB_DISPATCH=cloudtasks
GCP_PROJECT=your-gcp-project
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=pvep-jobs
CLOUD_TASKS_SERVICE_ACCOUNT=pvep-tasks@your-gcp-project.iam.gserviceaccount.com
# Base URL of the deployed worker service — no trailing /score.
WORKER_URL=https://pvep-worker-xxxx.run.app

# --- Redis ---
# NOT needed when JOB_DISPATCH=cloudtasks. Job state lives in Postgres; Redis
# is only the ARQ transport. Set it only if you switch back to JOB_DISPATCH=arq.
# REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# --- Object storage (GCS) ---
MATRIX_STORAGE_BACKEND=gcs
MATRIX_STORAGE_BUCKET=your-bucket-name
# GCS auth comes from the Cloud Run service account, not a key file.

# --- CORS: the deployed frontend origin(s), comma-separated ---
CORS_ORIGINS=https://your-frontend.vercel.app

# --- Worker only ---
# "http" (default) = FastAPI on $PORT, scores in-request, scales to zero.
# "arq"            = long-lived Redis consumer; needs REDIS_URL + min-instances 1.
WORKER_MODE=http

# --- AlphaMissense (optional) ---
# The ~1.2GB SQLite isn't shipped in the image. To enable AlphaMissense in
# prod, bake it into the image or mount it, and point this at it; otherwise
# the app runs fine without it.
# ALPHAMISSENSE_DB_PATH=/data/alphamissense.sqlite
