# Worker image — carries torch + transformers + model weights.
#
# Two run modes, selected by WORKER_MODE (see the CMD at the bottom):
#   http (default) — FastAPI on $PORT, scores inside the request. Lets Cloud
#                    Run scale the worker to zero when idle.
#   arq            — long-lived Redis consumer, model warm forever. Local dev,
#                    or any always-on host.
FROM python:3.11-slim

# No `dssp` package here on purpose. mkdssp 4.x aborts without the wwPDB
# chemical component dictionary, which Debian doesn't ship and which is
# ~800MB uncompressed, so it never produced output in this image. Secondary
# structure is computed in pure Python instead (worker/features/dssp.py).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install the heavy ML deps in their own layer first so they stay cached
# across source changes. Versions mirror the [worker] extra in pyproject.toml
# — the editable install below is a near-no-op for these once satisfied.
#
# torch comes from PyTorch's CPU-only index: the default linux wheel bundles
# ~2GB of CUDA/cuDNN libraries that a Cloud Run CPU instance never touches.
# The +cpu build drops the worker image from ~9GB to ~2-3GB (faster cold
# starts, cheaper storage). Inference runs on CPU in production anyway.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    "torch>=2.4.0" \
    && pip install --no-cache-dir \
    "transformers>=4.45.0" \
    "accelerate>=0.34.0" \
    "pydssp>=0.9.0"

# Source must be present before the editable install: setuptools discovers
# packages from the copied tree at build time (see pyproject find/include).
COPY pyproject.toml .
COPY contracts/ ./contracts/
COPY domain/ ./domain/
COPY db/ ./db/
COPY storage/ ./storage/
COPY config.py .
# The worker imports JobService from api/services — copy the services
# subtree only, not the routes/main. Nothing torch-related leaks into
# the API image because api/ can be imported without api/main.
COPY api/__init__.py ./api/__init__.py
COPY api/services/ ./api/services/
COPY worker/ ./worker/

RUN pip install --no-cache-dir -e ".[worker]"

# Shell form so $PORT and $WORKER_MODE are expanded at runtime. Timeout is
# generous: a cold instance pays the ESM-2 load before its first score.
CMD if [ "$WORKER_MODE" = "arq" ]; then \
        arq worker.main.WorkerSettings; \
    else \
        uvicorn worker.http_app:app --host 0.0.0.0 --port ${PORT:-8080} \
            --timeout-keep-alive 1800; \
    fi
